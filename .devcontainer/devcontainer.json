{
  "name": "Perfil con libro de visitas",
  "dockerComposeFile": "../compose.yaml",
  "service": "web",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Perfil web",
      "onAutoForward": "openPreview"
    }
  },

  "postStartCommand": "cp -n .env.example .env || true; docker compose up -d --build"
}